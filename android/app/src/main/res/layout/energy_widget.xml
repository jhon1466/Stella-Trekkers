<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de energía. Las secciones se muestran u ocultan según el tamaño (ver EnergyWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_frame">

    <!-- Imagen de fondo del personaje -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Fondo de personaje" />

    <!-- Degradado inferior para legibilidad -->
    <ImageView
        android:id="@+id/widget_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bottom_gradient"
        android:contentDescription="Gradiente" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Chip superior: personaje / nombre de la app -->
        <LinearLayout
            android:id="@+id/widget_top_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_chip_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Icono" />

            <TextView
                android:id="@+id/widget_chip_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:text="Stella Trekkers"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Perfil (sólo en tamaño grande) -->
        <LinearLayout
            android:id="@+id/widget_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_pill_bg"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#D8D4E8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_collection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#D8D4E8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Separador flexible (View no está permitida en RemoteViews) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Fila inferior: energía + cuenta atrás + recarga -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_stamina_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Icono de energía" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="4"
                    android:text="--/240"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Cuenta atrás nativa: avanza sola sin actualizar el widget -->
                <Chronometer
                    android:id="@+id/widget_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="3"
                    android:textColor="#D8D4E8"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="3"
                    android:maxLines="1"
                    android:text="Toca para sincronizar"
                    android:textColor="#D8D4E8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_full_at"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#D8D4E8"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_refresh_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_refresh_circle"
                android:contentDescription="Actualizar"
                android:padding="7dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
